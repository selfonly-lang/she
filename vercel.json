{
  "headers": [
    {
      "source": "/assets/covers/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/s/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/c/:slug",
      "destination": "/index.html"
    }
  ]
}
